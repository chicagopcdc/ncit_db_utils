# Pick ONE backend by setting the relevant variables.
# Precedence if multiple are set: sqlite_file > duckdb_file > dbname.

# --- SQLite ---
# sqlite_file=ncit.sqlite

# --- DuckDB ---
# duckdb_file=ncit.duckdb

# --- PostgreSQL ---
# dbname=ncit
# host=localhost
# port=5432
# user=ncit_user
# schema=public
# db_password=changeme

# --- Optional: load the NCIt flat file from a local archive ---
# If set, the Thesaurus_<version>.FLAT.zip is read from this path instead
# of being downloaded from EVS. Works with any backend above.
# ncit_file_name=/data/Thesaurus_24.12e.FLAT.zip
